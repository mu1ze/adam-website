{
  "name": "app-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3369",
    "build": "next build",
    "build:docx-index": "node scripts/build-docx-index.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:worker": "npx opennextjs-cloudflare build",
    "preview": "npm run build:worker && npx opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && npx opennextjs-cloudflare deploy",
    "test": "npx playwright test",
    "test:mobile": "npx playwright test --project='mobile-chrome'",
    "test:desktop": "npx playwright test --project='desktop-chrome'",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@libsql/client": "^0.17.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "bcryptjs": "^3.0.3",
    "cloudflare": "^6.0.0",
    "next": "^16.2.9",
    "pagefind": "^1.5.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@types/react": "19.2.15",
    "typescript": "6.0.3",
    "wrangler": "^4.103.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
